# Builds mpv with NVIDIA DLSS and Video Frame Generation, Video Super Resolution,
# the ModernZ interface and
# thumbfast thumbnails into /opt/mpv-dlssg, next to the system mpv and ffmpeg,
# which are not touched.
#
# The resulting package links the proprietary NVIDIA NGX SDK against GPL code:
# build it for your own use, do not redistribute it.
#
# The sources can be overridden, e.g. to build from local clones:
#   FFMPEG_REPO=file://$HOME/FFmpeg MPV_REPO=file://$HOME/mpv makepkg -si

pkgname=mpv-dlssg-git
pkgver=r0
pkgrel=1
pkgdesc='mpv with NVIDIA DLSS Frame Generation (2x-6x)'
arch=(x86_64)
url='https://github.com/s-brue/mpv'
license=(GPL-3.0-or-later LGPL-2.1-only MPL-2.0 LicenseRef-NVIDIA-RTX-SDK)
provides=(mpv-dlssg)
conflicts=(mpv-dlssg)
_prefix=/opt/mpv-dlssg
_dlss_tag=v310.9.16
# NVIDIA VFX SDK, from the wheel of its Python package: proprietary libraries
_vfx_whl=nvidia_vfx-0.2.0.0-cp312-abi3-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl

depends=(
  alsa-lib bzip2 curl dav1d fontconfig freetype2 fribidi gnutls harfbuzz
  lame lcms2 libarchive libass libbluray libcaca libcdio libcdio-paranoia libdisplay-info
  libdrm libdvdnav libdvdread libgl libjpeg-turbo libjxl libpipewire libplacebo libpulse
  libsixel libsoxr libssh libva libvdpau libvorbis libvpx libwebp libx11 libxcb libxext libxfixes
  libxkbcommon libxml2 libxpresent libxrandr libxss libxv luajit mesa nvidia-utils opus
  rubberband sndio svt-av1 uchardet vapoursynth vulkan-icd-loader wayland x264 x265 zimg zlib
)
makedepends=(clang ffnvcodec-headers git meson nasm shaderc spirv-headers vulkan-headers wayland-protocols)
# lto: the NGX SDK is a prebuilt static library.
# strip: stripping would modify the signed NVIDIA library and NGX then rejects
# it; our own binaries are stripped by the install steps instead.
options=(!lto !debug !strip)

source=(
  "FFmpeg::git+${FFMPEG_REPO:-https://github.com/s-brue/FFmpeg.git}#branch=${FFMPEG_BRANCH:-dlssg}"
  "mpv::git+${MPV_REPO:-https://github.com/s-brue/mpv.git}#branch=${MPV_BRANCH:-dlssg}"
  "ModernZ::git+${MODERNZ_REPO:-https://github.com/s-brue/ModernZ.git}#branch=${MODERNZ_BRANCH:-dlssg}"
  "thumbfast::git+${THUMBFAST_REPO:-https://github.com/s-brue/thumbfast.git}#branch=${THUMBFAST_BRANCH:-dlssg}"
  "https://pypi.nvidia.com/nvidia-vfx/$_vfx_whl"
  "DLSS::git+${DLSS_REPO:-https://github.com/NVIDIA/DLSS.git}#tag=${_dlss_tag}"
)
noextract=("$_vfx_whl")
sha256sums=(SKIP SKIP SKIP SKIP 0252866a7b798a6f92c8543443d88f716e8c5bbc6a7ddd77a2754728dada9fa8 SKIP)

pkgver() {
  local repo
  for repo in mpv FFmpeg ModernZ thumbfast; do
    printf 'r%s.%s.' "$(git -C $repo rev-list --count HEAD)" \
      "$(git -C $repo rev-parse --short HEAD)"
  done | sed 's/\.$//'
}

build() {
  local dlss="$srcdir/DLSS" stage="$srcdir/stage"
  local libdir="$stage$_prefix/lib"

  mkdir -p build-ffmpeg && cd build-ffmpeg
  "$srcdir/FFmpeg/configure" \
    --prefix="$_prefix" --enable-shared --disable-static --disable-doc \
    --extra-cflags="-I$dlss/include" --extra-cxxflags="-I$dlss/include" \
    --extra-ldflags="-Wl,-rpath,$_prefix/lib -L$dlss/lib/Linux_x86_64" \
    --enable-gpl --enable-version3 --enable-nonfree --enable-libngx \
    --enable-cuda-llvm --enable-nvdec --enable-nvenc --enable-vulkan --enable-vapoursynth \
    --enable-fontconfig --enable-gnutls --enable-lcms2 --enable-libass --enable-libbluray \
    --enable-libdav1d --enable-libdrm --enable-libdvdnav --enable-libdvdread \
    --enable-libfreetype --enable-libfribidi --enable-libharfbuzz --enable-libjxl \
    --enable-libmp3lame --enable-libopus --enable-libplacebo --enable-libpulse \
    --enable-libsoxr --enable-libssh --enable-libsvtav1 --enable-libvorbis --enable-libvpx \
    --enable-libwebp --enable-libx264 --enable-libx265 --enable-libxml2 --enable-libzimg
  make
  make DESTDIR="$stage" install

  # build mpv against the FFmpeg still in the staging directory
  cd "$srcdir"
  rm -rf pc && mkdir pc
  local f
  for f in "$libdir"/pkgconfig/*.pc; do
    sed "s|$_prefix|$stage$_prefix|g" "$f" > "pc/${f##*/}"
  done
  PKG_CONFIG_PATH="$srcdir/pc" \
  LDFLAGS="$LDFLAGS -Wl,-rpath,$_prefix/lib -Wl,-rpath-link,$libdir" \
  meson setup build-mpv mpv --wipe --prefix="$_prefix" --libdir=lib --buildtype=release \
    -Dlua=luajit -Dvapoursynth=enabled -Dvulkan=enabled -Dlibmpv=false
  meson compile -C build-mpv
}

package() {
  cp -a "$srcdir/stage/." "$pkgdir/"
  meson install -C build-mpv --destdir "$pkgdir" --strip

  # keep only what is needed at run time, and do not clash with the system mpv
  rm -rf "$pkgdir$_prefix"/{include,lib/pkgconfig,share/applications,share/icons,share/zsh,share/bash-completion,share/fish}

  install -Dm644 DLSS/lib/Linux_x86_64/rel/libnvidia-ngx-dlssg.so.* -t "$pkgdir$_prefix/lib/ngx/"
  # only what Video Frame Generation and Super Resolution need of the VFX SDK
  local vfx="$srcdir/vfx"
  rm -rf "$vfx" && mkdir -p "$vfx"
  bsdtar -xf "$srcdir/$_vfx_whl" -C "$vfx" 'nvidia_vfx.libs/libcudart-*' \
    'nvvfx/libs/libNVCVImage.so' 'nvvfx/libs/libVideoFX.so' 'nvvfx/libs/libVideoFXLocal.so' \
    'nvvfx/libs/libnvVFXVideoFrameGeneration.so' 'nvvfx/libs/libcudnn.so.9' \
    'nvvfx/libs/libnppc.so.12' 'nvvfx/libs/libnppial.so.12' 'nvvfx/libs/libnppicc.so.12' \
    'nvvfx/libs/libnppidei.so.12' 'nvvfx/libs/libnppig.so.12' \
    'nvvfx/libs/libnvngxruntime.so' 'nvvfx/libs/libnvVFXVideoSuperRes.so' \
    'nvvfx/libs/libnvidia-ngx-vsr.so.*' '*.dist-info/licenses/*'
  install -Dm644 "$vfx"/nvvfx/libs/*.so* "$vfx"/nvidia_vfx.libs/* -t "$pkgdir$_prefix/lib/nvvfx/"
  find "$vfx" -path '*dist-info/licenses/*' -type f \
    -exec install -Dm644 {} -t "$pkgdir/usr/share/licenses/$pkgname/nvidia-vfx/" \;
  install -Dm644 mpv/dlssg/dlssg.lua mpv/dlssg/dlssg-sharpen.glsl -t "$pkgdir$_prefix/share/mpv-dlssg/"
  install -Dm755 mpv/dlssg/mpv-dlssg -t "$pkgdir/usr/bin/"
  # the interface; its icon font has to be where fontconfig finds it
  install -Dm644 ModernZ/modernz.lua -t "$pkgdir$_prefix/share/mpv-dlssg/"
  install -Dm644 ModernZ/modernz-icons.ttf -t "$pkgdir/usr/share/fonts/mpv-dlssg/"
  install -Dm644 ModernZ/LICENSE "$pkgdir/usr/share/licenses/$pkgname/ModernZ-LGPL-2.1.txt"
  install -Dm644 thumbfast/thumbfast.lua -t "$pkgdir$_prefix/share/mpv-dlssg/"
  install -Dm644 thumbfast/LICENSE "$pkgdir/usr/share/licenses/$pkgname/thumbfast-MPL-2.0.txt"
  install -Dm644 DLSS/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/NVIDIA-RTX-SDK.txt"
}
