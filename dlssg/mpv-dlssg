#!/bin/sh
# mpv with NVIDIA DLSS Frame Generation (the dlssg_vulkan filter).
prefix=/opt/mpv-dlssg
export DLSSG_LIB_PATH="${DLSSG_LIB_PATH:-$prefix/lib/ngx}"

# ModernZ interface, unless the configuration already has an interface of its
# own (two of them would be drawn on top of each other) or MPV_DLSSG_OSC=no.
config=${MPV_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mpv}
ui=--script=$prefix/share/mpv-dlssg/modernz.lua
for script in "$config"/scripts/[Mm]odern* "$config"/scripts/*osc*; do
    [ -e "$script" ] && ui=
done
[ "${MPV_DLSSG_OSC:-}" = no ] && ui=

# thumbfast thumbnails, unless the configuration has its own copy or
# MPV_DLSSG_THUMBNAILS=no. It has to generate them with our mpv, not with the
# system one, which may be missing or built without what HDR needs.
thumbs=--script=$prefix/share/mpv-dlssg/thumbfast.lua
for script in "$config"/scripts/*thumbfast*; do
    [ -e "$script" ] && thumbs=
done
[ "${MPV_DLSSG_THUMBNAILS:-}" = no ] && thumbs=
thumbs_mpv=${thumbs:+--script-opts-append=thumbfast-mpv_path=$prefix/bin/mpv}
grep -qs '^mpv_path=' "$config/script-opts/thumbfast.conf" && thumbs_mpv=

exec "$prefix/bin/mpv" --gpu-api=vulkan --script="$prefix/share/mpv-dlssg/dlssg.lua" \
    ${ui:+"$ui"} ${thumbs:+"$thumbs"} ${thumbs_mpv:+"$thumbs_mpv"} "$@"
